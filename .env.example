# Application
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://reporeveal:reporeveal@localhost:5432/reporeveal

# GitHub (optional; improves rate limits)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_TIMEOUT_SECONDS=30

# OpenAI (optional; AI features skip when unset or AI_ENABLED=false)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_ENABLED=true
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_RETRIEVED_CHUNKS=12
EMBEDDING_DIMENSIONS=1536

# Analysis limits
MAX_ARCHIVE_BYTES=52428800
MAX_EXTRACTED_BYTES=157286400
MAX_EXTRACTED_FILES=5000
MAX_PYTHON_FILES=2000
MAX_SINGLE_FILE_BYTES=1048576
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=/tmp/reporeveal

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_REPOSITORY_URL=https://github.com/pallets/click
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/androodo/RepoReveal
